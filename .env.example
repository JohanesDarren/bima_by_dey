# ---- Supabase (PRD §5.3) ----------------------------------------------
# Create a project at https://supabase.com, then paste credentials here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---- Kroombox RAG API (PRD §5.4) ---------------------------------------
# Public HTTPS URL of the FastAPI server (NOT a LAN IP when on a device).
EXPO_PUBLIC_KROOMBOX_URL=https://YOUR_KROOMBOX_HOST.example.com

# ---- 9router: speech-to-text for voice messages ------------------------
# Only `groq` serves STT on this router. Keep the provider prefix.
EXPO_PUBLIC_9ROUTER_BASE_URL=https://9router.jagoai.dev/v1
EXPO_PUBLIC_9ROUTER_API_KEY=
EXPO_PUBLIC_9ROUTER_STT_MODEL=groq/whisper-large-v3
